# DB1 HTTP 入口 port；容器內固定使用 3306。
MYSQL_DB1_PORT=

# DB2 HTTP 入口 port；容器內固定使用 3306。
MYSQL_DB2_PORT=

# Root password used for MySQL administration.
MYSQL_ROOT_PASSWORD=

# To create a database during initialization.
# MYSQL_DATABASE=

# To create an application user during initialization.
# MYSQL_USER=
# MYSQL_PASSWORD=