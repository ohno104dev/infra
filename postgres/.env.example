# DB1 HTTP 入口 port；容器內固定使用 3306。
PGSQL_DB1_PORT=

# DB2 HTTP 入口 port；容器內固定使用 3306。
PGSQL_DB2_PORT=

# To use a custom superuser name, set POSTGRES_USER.
# Defaults to `postgres`.
# POSTGRES_USER=postgres

# To create a custom database during initialization, set POSTGRES_DB.
# Defaults to POSTGRES_USER.
# POSTGRES_DB=postgres

POSTGRES_PASSWORD=